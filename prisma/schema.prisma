  unit      String   @default("")
  /** Optional dimension value (event id, campaign id) for filtered metrics. */
  dimension String?
  takenAt   DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, metricKey, takenAt])
}

