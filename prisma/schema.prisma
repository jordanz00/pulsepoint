// PulsePoint — Prisma schema (multi-tenant AMS, Members + Events MVP)
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum OrgRole {
  OWNER
  ADMIN
  STAFF
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  LAPSED
}

/// Seniority band — used to flag C-suite and executive contacts.
enum LeadershipLevel {
  C_SUITE
  SENIOR_EXECUTIVE
  DIRECTOR
  MANAGER
  PROFESSIONAL
  OTHER
}

/// Whether the role is with this association or an external org (e.g. board at another nonprofit).
enum MemberRoleScope {
  THIS_ASSOCIATION
  EXTERNAL_ORGANIZATION
}

/// Role category for filtering and display.
enum MemberRoleCategory {
  EXECUTIVE
  BOARD
  COMMITTEE
  CHAPTER
  STAFF
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WAITLIST
  CANCELLED
}

enum EventFormat {
  IN_PERSON
  VIRTUAL
  HYBRID
}

/// Event program type — virtual career fair is Alpha (Wave 1 healthcare AMS).
enum EventKind {
  STANDARD
  VIRTUAL_CAREER_FAIR
}

/// Member workforce / pipeline persona for Learn + career fair (alpha).
enum WorkforcePersona {
  NONE
  STUDENT
  NEW_GRAD
  CAREER_CHANGER
  EXPERIENCED
  EMPLOYER_PARTNER
}

enum RefundStatus {
  NONE
  REQUESTED
  APPROVED
  COMPLETED
  DENIED
}

enum EventAssetKind {
  LOGO
  BANNER
  SPONSOR
  BADGE
  GENERAL
}

enum EventScheduledEmailStatus {
  SCHEDULED
  SENT
  CANCELLED
  FAILED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum AutomationOutcome {
  PARTIAL_SUCCESS
  FAILED
}

enum MemberImportBatchStatus {
  PENDING_REVIEW
  APPLIED
  REJECTED
}

enum MemberImportRowStatus {
  PENDING
  APPLIED
  SKIPPED_DUPLICATE
  REJECTED
}

/// Relationship health — people-first CRM (not deal pipeline).
enum RelationshipHealth {
  STRONG
  STEADY
  COOLING
  AT_RISK
}

enum MemberNoteType {
  RELATIONSHIP
  FOLLOW_UP
  GENERAL
}

enum ContactSourceKind {
  MANUAL
  CSV_IMPORT
  EMAIL_CAPTURE
  WEB_CAPTURE
  LINKEDIN
  DIRECTORY
}

enum MemberRelationType {
  COLLEAGUE
  REFERRAL
  MENTOR
  MENTEE
  BOARD_PEER
  SPOUSE
  OTHER
}

enum CrmWorkflowKind {
  ONBOARD_MEMBER
  RE_ENGAGE
  BOARD_OUTREACH
  HIRING
  INFLUENCER_PR
  FUNDRAISING
  NETWORKING
  ACCOUNTS_RECEIVABLE
  CUSTOM
}

enum CrmWorkflowRunStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum DealReportVisibility {
  PRIVATE
  TEAM
  ORG
}

enum DealReportType {
  LOST_BY_STAGE
  WON_OVER_TIME
  LOST_BY_REASON
  REVENUE_FORECAST
  DEAL_CONVERSION
  DEAL_PROGRESS
  TEAM_LEADERBOARD
}

enum DealChartType {
  BAR
  DONUT
  TABLE
}

model Organization {
  id               String   @id
  slug             String   @unique
  name             String
  plan             String   @default("trial")
  stripeCustomerId String?
  /// Public directory settings — fields, visibility, layout.
  directoryConfig Json?
  /// Enabled payment gateway ids from lib/payment-gateway-registry.
  paymentGatewayConfig Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  memberships   OrgMembership[]
  members       Member[]
  memberRoles   MemberRole[]
  memberTiers   MemberTier[]
  events        Event[]
  registrations EventRegistration[]
  auditLogs            AuditLog[]
  memberNotes          MemberNote[]
  automationExceptions AutomationException[]
  memberImportBatches  MemberImportBatch[]
  memberImportRows     MemberImportRow[]

  // Roadmap modules (alpha — schema first, full features in coming releases)
  ceCreditTypes      CECreditType[]
  ceCreditAwards     CECreditAward[]
  courses            Course[]
  courseEnrollments  CourseEnrollment[]
  learnVideoPlaylists     LearnVideoPlaylist[]
  learnVideoItems         LearnVideoItem[]
  learnWorkforcePrograms  LearnWorkforceProgram[]
  learnProgramEnrollments LearnProgramEnrollment[]
  commerceProducts   CommerceProduct[]
  commerceOrders     CommerceOrder[]
  commerceOrderItems CommerceOrderItem[]
  campaigns          Campaign[]
  donations          Donation[]
  emailTemplates     EmailTemplate[]
  emailCampaigns     EmailCampaign[]
  emailAudiences     EmailAudience[]
  emailSendLogs      EmailSendLog[]
  insightsSnapshots  InsightsSnapshot[]

  // CRM & platform extensions (alpha)
  memberBadges         MemberBadge[]
  renewalWorkflows     RenewalWorkflow[]
  eventSpeakers        EventSpeaker[]
  eventSponsors        EventSponsor[]
  eventSessions        EventSession[]
  communitySpaces      CommunitySpace[]
  communityMemberships CommunityMembership[]
  reportSchedules      ReportSchedule[]
  eventTicketTypes     EventTicketType[]
  eventPromoCodes      EventPromoCode[]
  eventAssets          EventAsset[]
  eventSurveys         EventSurvey[]
  eventSurveyResponses EventSurveyResponse[]
  eventSessionRegs     EventSessionRegistration[]
  eventScheduledEmails EventScheduledEmail[]
  memberSubscriptions  MemberSubscription[]
  dashboardLayouts     DashboardLayout[]
  communityPosts       CommunityPost[]
  communityDocuments   CommunityDocument[]

  // PulsePoint CRM (Nimble-inspired — relationship-first)
  memberRelationships MemberRelationship[]
  contactSources      ContactSource[]
  crmWorkflows        CrmWorkflow[]
  crmWorkflowRuns     CrmWorkflowRun[]
  webCaptureKeys       WebCaptureKey[]

  dealPipelines        DealPipeline[]
  deals                Deal[]
  dealLossReasons      DealLossReason[]
  dealReportDashboards DealReportDashboard[]

  emailSequences           EmailSequence[]
  emailSequenceSteps       EmailSequenceStep[]
  emailSequenceEnrollments EmailSequenceEnrollment[]
  webForms                 WebForm[]
  webFormSubmissions       WebFormSubmission[]

  // Enterprise association structure
  memberOrganizations      MemberOrganization[]
  committees               Committee[]
  committeeMemberships     CommitteeMembership[]
  committeeMeetings        CommitteeMeeting[]
  advocacyIssues              AdvocacyIssue[]
  advocacyCampaigns           AdvocacyCampaign[]
  advocacyCampaignResponses   AdvocacyCampaignResponse[]
  emergencyContacts        EmergencyContact[]
  emergencyReadinessReports EmergencyReadinessReport[]
  integrationConnections   IntegrationConnection[]
}

model User {
  id        String   @id
  email     String   @unique
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrgMembership[]
  auditLogs   AuditLog[]
  memberNotes         MemberNote[]
  memberImportUploads MemberImportBatch[]
}

model OrgMembership {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      OrgRole  @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

model Member {
  id            String       @id @default(cuid())
  orgId         String
  firstName     String
  lastName      String
  email         String?
  phone         String?
  status        MemberStatus @default(ACTIVE)
  joinedAt      DateTime     @default(now())
  /// When this membership next requires renewal. Used by members.renewal.sweep job.
  renewalDueAt  DateTime?
  /// Cached engagement score (0–100). Synced from MemberPulse overall score.
  engagementScore Int @default(0)
  /// active | moderate | at_risk | inactive
  engagementTier  String @default("inactive")
  /// MemberPulse dimensional snapshot — lib/member-pulse/compute.ts
  memberPulseData Json?
  /// Optional dues tier for renewal workflows.
  tierId          String?
  customFields  Json
  tags          Json
  clerkUserId   String?
  /// Professional context — enriched profile (CRM).
  company       String?
  jobTitle      String?
  linkedInUrl   String?
  websiteUrl    String?
  /// Firmographics + ICP from Prospector (demo rule-based; production = IT APIs).
  enrichmentData Json?
  /// People-first relationship signal (not pipeline stage).
  relationshipHealth RelationshipHealth @default(STEADY)
  lastTouchAt        DateTime?
  nextFollowUpAt     DateTime?
  /// Learn / workforce pipeline persona (alpha).
  workforcePersona   WorkforcePersona @default(NONE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  organization  Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tier          MemberTier?         @relation(fields: [tierId], references: [id], onDelete: SetNull)
  /// Hospital / health system organizational account (parent-child hierarchy).
  organizationAccountId String?
  organizationAccount   MemberOrganization? @relation(fields: [organizationAccountId], references: [id], onDelete: SetNull)
  registrations EventRegistration[]
  notes         MemberNote[]
  roles         MemberRole[]
  badges        MemberBadge[]

  // Roadmap module relations
  ceCreditAwards    CECreditAward[]
  courseEnrollments CourseEnrollment[]
  learnProgramEnrollments LearnProgramEnrollment[]
  commerceOrders    CommerceOrder[]
  donations         Donation[]
  communityMemberships CommunityMembership[]
  subscriptions        MemberSubscription[]
  relationshipsFrom    MemberRelationship[] @relation("MemberRelFrom")
  relationshipsTo      MemberRelationship[] @relation("MemberRelTo")
  contactSources       ContactSource[]
  crmWorkflowRuns      CrmWorkflowRun[]
  committeeMemberships CommitteeMembership[]
  emergencyContacts    EmergencyContact[]

  @@index([orgId])
  @@index([orgId, organizationAccountId])
  @@index([orgId, email])
  @@index([orgId, status])
  @@index([orgId, createdAt])
  @@index([orgId, lastName, firstName])
  @@index([orgId, nextFollowUpAt])
  @@index([orgId, relationshipHealth])
}

/// Leadership and governance roles — C-suite, board seats (this org or external), committees.
model MemberRole {
  id                 String             @id @default(cuid())
  orgId              String
  memberId           String
  category           MemberRoleCategory
  scope              MemberRoleScope
  leadershipLevel    LeadershipLevel?
  /// Display title: CEO, Board Chair, Trustee, Committee Chair, etc.
  title              String
  /// External org name when scope = EXTERNAL_ORGANIZATION; optional label when internal (e.g. chapter).
  organizationName   String?
  isCurrent          Boolean            @default(true)
  startDate          DateTime?
  endDate            DateTime?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([orgId, memberId])
  @@index([orgId, category])
  @@index([orgId, leadershipLevel])
  @@index([orgId, scope])
}

/// Canonical staff notes — do not store pipeline notes in customFields or ad-hoc spreadsheets.
model MemberNote {
  id           String   @id @default(cuid())
  orgId        String
  memberId     String
  authorUserId String?
  body         String
  noteType     MemberNoteType @default(GENERAL)
  /// email | call | meeting | linkedin | in_person | other
  channel      String?
  nextFollowUpAt DateTime?
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([orgId, memberId])
  @@index([orgId, createdAt])
}

model MemberTier {
  id              String          @id @default(cuid())
  orgId           String
  name            String
  priceCents      Int             @default(0)
  billingInterval BillingInterval @default(ANNUAL)
  /** Linked CommerceProduct for dues checkout (eStore). */
  productId       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  product      CommerceProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  members      Member[]
  subscriptions MemberSubscription[]

  @@index([orgId])
}

model Event {
  id          String      @id @default(cuid())
  orgId       String
  title       String
  description String      @default("")
  startsAt    DateTime
  endsAt      DateTime?
  capacity    Int?
  priceCents  Int         @default(0)
  status      EventStatus @default(DRAFT)
  publicSlug  String
  venueName   String      @default("")
  venueAddress String     @default("")
  timezone    String      @default("America/New_York")
  format      EventFormat @default(IN_PERSON)
  eventKind   EventKind   @default(STANDARD)
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  waitlistEnabled      Boolean @default(true)
  /// Planner checklist, budget notes, internal tags — JSON.
  plannerConfig Json?
  /// Branded microsite settings (theme, hero copy) — JSON.
  micrositeConfig Json?
  /// EasyDNN / CMS export metadata — JSON.
  websiteExportConfig Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  organization  Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]
  speakers      EventSpeaker[]
  sponsors      EventSponsor[]
  sessions      EventSession[]
  ticketTypes   EventTicketType[]
  promoCodes    EventPromoCode[]
  assets        EventAsset[]
  survey        EventSurvey?
  scheduledEmails EventScheduledEmail[]
  sessionRegistrations EventSessionRegistration[]
  learnWorkforcePrograms LearnWorkforceProgram[]

  @@unique([orgId, publicSlug])
  @@index([orgId])
  @@index([orgId, status])
}

model EventRegistration {
  id                    String             @id @default(cuid())
  orgId                 String
  eventId               String
  memberId              String?
  ticketTypeId          String?
  guestEmail            String?
  guestName             String?
  status                RegistrationStatus @default(PENDING)
  stripePaymentIntentId String?
  paidAt                DateTime?
  checkedInAt           DateTime?
  cancelledAt           DateTime?
  waitlistPosition      Int?
  staffNotes            String             @default("")
  promoCodeUsed         String?
  badgeCode             String?
  refundStatus          RefundStatus       @default(NONE)
  refundAmountCents     Int?
  refundNotes           String             @default("")
  refundedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member         Member?        @relation(fields: [memberId], references: [id], onDelete: SetNull)
  ticketType     EventTicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  sessionRegistrations EventSessionRegistration[]
  surveyResponses      EventSurveyResponse[]

  @@index([orgId])
  @@index([eventId])
  @@index([orgId, eventId])
  @@index([orgId, memberId])
  @@index([orgId, status])
  @@index([orgId, createdAt])
  @@index([eventId, status])
  @@index([eventId, badgeCode])
}

model EventAsset {
  id        String         @id @default(cuid())
  orgId     String
  eventId   String
  kind      EventAssetKind @default(GENERAL)
  label     String         @default("")
  url       String
  altText   String         @default("")
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([orgId, eventId])
}

model EventSurvey {
  id        String   @id @default(cuid())
  orgId     String
  eventId   String   @unique
  title     String   @default("Post-event feedback")
  active    Boolean  @default(false)
  /// JSON array: { id, label, type: text|rating|choice, options?: string[] }
  questions Json
  opensAt   DateTime?
  closesAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  responses      EventSurveyResponse[]

  @@index([orgId])
}

model EventSurveyResponse {
  id             String   @id @default(cuid())
  orgId          String
  surveyId       String
  registrationId String?
  guestEmail     String?
  answers        Json
  submittedAt    DateTime @default(now())

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  survey         EventSurvey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  registration   EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([surveyId])
  @@index([orgId, surveyId])
}

model EventSessionRegistration {
  id             String   @id @default(cuid())
  orgId          String
  eventId        String
  sessionId      String
  registrationId String
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event          Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session        EventSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  registration   EventRegistration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([sessionId, registrationId])
  @@index([eventId])
  @@index([registrationId])
}

model EventScheduledEmail {
  id        String                    @id @default(cuid())
  orgId     String
  eventId   String
  name      String
  /// EventCorrespondenceSegment id
  segment   String
  subject   String
  bodyText  String
  sendAt    DateTime
  status    EventScheduledEmailStatus @default(SCHEDULED)
  sentAt    DateTime?
  createdAt DateTime                  @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([orgId, eventId])
  @@index([status, sendAt])
}

model EventPromoCode {
  id              String   @id @default(cuid())
  orgId           String
  eventId         String
  code            String
  label           String   @default("")
  discountPercent Int?
  discountCents   Int?
  maxUses         Int?
  usedCount       Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, code])
  @@index([orgId, eventId])
}

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String
  userId    String?
  action    String
  entity    String
  entityId  String?
  diff      Json?
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([orgId, createdAt])
  @@index([orgId, entityId])
}

model WebhookIdempotency {
  id        String   @id
  source    String
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}

/// Soft-fail automation queue — partial webhook/import failures land here for triage.
model AutomationException {
  id         String            @id @default(cuid())
  orgId      String
  workflow   String
  step       String
  outcome    AutomationOutcome
  message    String            @default("")
  context    Json
  resolvedAt DateTime?
  createdAt  DateTime          @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, resolvedAt])
  @@index([orgId, createdAt])
}

/// Staging — never write CSV rows directly to Member until batch is applied.
model MemberImportBatch {
  id           String                @id @default(cuid())
  orgId        String
  uploadedById String?
  fileName     String                @default("")
  status       MemberImportBatchStatus @default(PENDING_REVIEW)
  rowCount     Int                   @default(0)
  createdAt    DateTime              @default(now())
  appliedAt    DateTime?

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  uploadedBy   User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  rows         MemberImportRow[]

  @@index([orgId, status])
}

model MemberImportRow {
  id        String              @id @default(cuid())
  orgId     String
  batchId   String
  rowIndex  Int
  firstName String
  lastName  String
  email     String?
  phone     String?
  company   String?
  jobTitle  String?
  /// ACTIVE | INACTIVE | LAPSED when provided in CSV
  memberStatus String?
  /// Resolved at apply time from tier name in CSV
  tierName  String?
  renewalDueAt DateTime?
  /// Resolved at apply time from hospital account name in CSV
  organizationName String?
  status    MemberImportRowStatus @default(PENDING)
  matchMemberId String?
  createdAt DateTime            @default(now())

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  batch        MemberImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([orgId, batchId])
  @@unique([batchId, rowIndex])
}

// ─────────────────────────────────────────────────────────────────────────────
// PulsePoint Learn (alpha) — CE credits, courses, transcript
// ─────────────────────────────────────────────────────────────────────────────

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ENROLLED
  COMPLETED
  WITHDRAWN
}

model CECreditType {
  id          String   @id @default(cuid())
  orgId       String
  code        String
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  awards       CECreditAward[]
  courses      Course[]

  @@unique([orgId, code])
  @@index([orgId])
}

model Course {
  id           String       @id @default(cuid())
  orgId        String
  title        String
  description  String       @default("")
  creditTypeId String?
  creditAmount Int          @default(0)
  status       CourseStatus @default(DRAFT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creditType   CECreditType?     @relation(fields: [creditTypeId], references: [id], onDelete: SetNull)
  enrollments  CourseEnrollment[]

  @@index([orgId, status])
}

model CourseEnrollment {
  id           String           @id @default(cuid())
  orgId        String
  courseId     String
  memberId     String
  status       EnrollmentStatus @default(ENROLLED)
  enrolledAt   DateTime         @default(now())
  completedAt  DateTime?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([courseId, memberId])
  @@index([orgId, status])
}

model CECreditAward {
  id           String   @id @default(cuid())
  orgId        String
  memberId     String
  creditTypeId String
  amount       Int
  source       String   @default("manual") // manual | course | event
  sourceRef    String?
  awardedAt    DateTime @default(now())
  note         String   @default("")

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  creditType   CECreditType  @relation(fields: [creditTypeId], references: [id], onDelete: Cascade)

  @@index([orgId, memberId])
  @@index([orgId, awardedAt])
}

/// Video playlist for Learn workforce tracks (alpha — no hosted video yet).
model LearnVideoPlaylist {
  id          String   @id @default(cuid())
  orgId       String
  title       String
  description String   @default("")
  trackSlug   String   @default("general")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items        LearnVideoItem[]

  @@index([orgId])
}

model LearnVideoItem {
  id          String  @id @default(cuid())
  orgId       String
  playlistId  String
  title       String
  videoUrl    String  @default("")
  durationMin Int     @default(0)
  ceEligible  Boolean @default(false)
  sortOrder   Int     @default(0)

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  playlist     LearnVideoPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@index([orgId, playlistId])
}

