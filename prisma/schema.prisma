enum CommunityVisibility {
  PRIVATE
  MEMBERS_ONLY
  PUBLIC
}

enum CommunityMemberRole {
  MEMBER
  MODERATOR
  ADMIN
}

model CommunitySpace {
  id          String              @id @default(cuid())
  orgId       String
  name        String
  slug        String
  description String              @default("")
  visibility  CommunityVisibility @default(PRIVATE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  organization Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberships  CommunityMembership[]
  posts        CommunityPost[]
  documents    CommunityDocument[]

  @@unique([orgId, slug])
  @@index([orgId])
}

model CommunityMembership {
  id        String              @id @default(cuid())
  orgId     String
  spaceId   String
  memberId  String
  role      CommunityMemberRole @default(MEMBER)
  joinedAt  DateTime            @default(now())

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  space        CommunitySpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  member       Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([spaceId, memberId])
  @@index([orgId, spaceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Reporting — scheduled delivery (alpha)
// ─────────────────────────────────────────────────────────────────────────────

enum ReportCadence {
  WEEKLY
  MONTHLY
  QUARTERLY
}

model ReportSchedule {
  id          String        @id @default(cuid())
  orgId       String
  name        String
  /** JSON string[] of metricKeys */
  metricKeys  Json
  cadence     ReportCadence @default(MONTHLY)
  /** JSON string[] of email recipients */
  recipients  Json
  active      Boolean       @default(true)
  nextRunAt   DateTime?
  lastRunAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, active])
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  PAST_DUE
  CANCELLED
}

model EventTicketType {
  id          String   @id @default(cuid())
  orgId       String
  eventId     String
  name        String
  description String   @default("")
  priceCents  Int      @default(0)
  capacity    Int?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  organization  Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  @@index([orgId, eventId])
}

model MemberSubscription {
  id               String             @id @default(cuid())
  orgId            String
  memberId         String
  tierId           String?
  productId        String?
  status           SubscriptionStatus @default(ACTIVE)
  billingInterval  BillingInterval    @default(ANNUAL)
  nextBillAt       DateTime
  lastBillAt       DateTime?
  paymentAdapterId String             @default("stripe")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  member       Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tier         MemberTier?      @relation(fields: [tierId], references: [id], onDelete: SetNull)
  product      CommerceProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([orgId, nextBillAt])
}

model DashboardLayout {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  isDefault Boolean  @default(false)
  /** JSON: { id, metricKey, title, x, y, w, h }[] */
  widgets   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, isDefault])
}

model CommunityPost {
  id             String   @id @default(cuid())
  orgId          String
  spaceId        String
  authorMemberId String?
  authorUserId   String?
  title          String
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  space          CommunitySpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([orgId, spaceId])
}

model CommunityDocument {
  id               String   @id @default(cuid())
  orgId            String
  spaceId          String
  title            String
  url              String
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  space          CommunitySpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([orgId, spaceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PulsePoint CRM — relationship-first (Nimble-inspired)
// ─────────────────────────────────────────────────────────────────────────────

/// Person-to-person link — nurture relationships, not just transactions.
model MemberRelationship {
  id             String             @id @default(cuid())
  orgId          String
  fromMemberId   String
  toMemberId     String
  relationType   MemberRelationType @default(COLLEAGUE)
  strength       Int                @default(3)
  notes          String             @default("")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fromMember   Member         @relation("MemberRelFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMember     Member         @relation("MemberRelTo", fields: [toMemberId], references: [id], onDelete: Cascade)

  @@unique([orgId, fromMemberId, toMemberId, relationType])
  @@index([orgId, fromMemberId])
  @@index([orgId, toMemberId])
}

/// Where a contact record originated — unified contact graph.
model ContactSource {
  id          String            @id @default(cuid())
  orgId       String
  memberId    String
  sourceKind  ContactSourceKind
  label       String            @default("")
  externalId  String?
  capturedAt  DateTime          @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  member       Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([orgId, memberId])
  @@index([orgId, sourceKind])
}

/// People-process workflows — Nimble-style boards across departments.
model CrmWorkflow {
  id          String          @id @default(cuid())
  orgId       String
  name        String
  kind        CrmWorkflowKind @default(CUSTOM)
  description String          @default("")
  /// Department label — Membership, Fundraising, HR, etc.
  department  String          @default("")
  active      Boolean         @default(true)
  /** Legacy linear steps — kept for compatibility */
  steps       Json
  /** Kanban stages: { id, order, label, instructions? } */
  stages      Json?
  /** Card fields: { id, label, type: text|date|select, options? } */
  fields      Json?
  /** Template key when created from a preset */
  fromTemplate String?
  /** Stage automations: [{ stageId, action, subject?, bodyText?, taskSubject? }] */
  stageAutomations Json @default("[]")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  runs         CrmWorkflowRun[]

  @@index([orgId, active])
  @@index([orgId, kind])
}

model CrmWorkflowRun {
  id           String               @id @default(cuid())
  orgId        String
  workflowId   String
  memberId     String
  status       CrmWorkflowRunStatus @default(ACTIVE)
  currentStep  Int                  @default(0)
  /// Current Kanban stage id
  stageId      String               @default("")
  /** Per-card custom field values keyed by field id */
  fieldValues  Json?
  sortOrder    Int                  @default(0)
  dueAt        DateTime?
  completedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workflow     CrmWorkflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([orgId, memberId])
  @@index([orgId, workflowId, stageId])
  @@index([orgId, dueAt])
}

/// Org-scoped token for browser capture / extension (hashed at rest).
model WebCaptureKey {
  id        String   @id @default(cuid())
  orgId     String
  label     String   @default("Default")
  keyHash   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, active])
}

model WebForm {
  id                  String   @id @default(cuid())
  orgId               String
  slug                String
  name                String
  description         String   @default("")
  fields              Json
  published           Boolean  @default(false)
  confirmEmailSubject String?
  confirmEmailBody    String?
  enrollSequenceId    String?
  addToWorkflowId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  submissions  WebFormSubmission[]

  @@unique([orgId, slug])
  @@index([orgId, published])
}

model WebFormSubmission {
  id        String   @id @default(cuid())
  orgId     String
  formId    String
  memberId  String?
  payload   Json
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  form         WebForm        @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// PulsePoint Deals + Reports (Nimble-inspired pipeline analytics)
// ─────────────────────────────────────────────────────────────────────────────

model DealPipeline {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deals        Deal[]

  @@index([orgId])
}

model DealLossReason {
  id        String   @id @default(cuid())
  orgId     String
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deals        Deal[]

  @@index([orgId])
}

model Deal {
  id              String     @id @default(cuid())
  orgId           String
  pipelineId      String
  title           String
  amountCents     Int        @default(0)
  stage           DealStage  @default(LEAD)
  lostAtStage     DealStage?
  lossReasonId    String?
  assigneeId      String?
  assigneeName    String     @default("")
  memberId        String?
  expectedCloseAt DateTime?
  closedAt        DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pipeline     DealPipeline   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  lossReason   DealLossReason? @relation(fields: [lossReasonId], references: [id], onDelete: SetNull)

  @@index([orgId, pipelineId, stage])
  @@index([orgId, assigneeId])
  @@index([orgId, closedAt])
}

model DealReportDashboard {
  id          String               @id @default(cuid())
  orgId       String
  name        String
  description String               @default("")
  visibility  DealReportVisibility @default(TEAM)
  isDefault   Boolean              @default(false)
  filters     Json
  createdBy   String               @default("")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  widgets      DealReportWidget[]

  @@index([orgId])
}

model DealReportWidget {
  id          String         @id @default(cuid())
  orgId       String
  dashboardId String
  reportType  DealReportType
  chartType   DealChartType  @default(BAR)
  title       String         @default("")
  sortOrder   Int            @default(0)
  filters     Json
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  dashboard DealReportDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([orgId, dashboardId])
}

// ── Enterprise association (statewide hospital association) ──

enum MemberOrganizationType {
  HEALTH_NETWORK
  HEALTH_SYSTEM
  HOSPITAL
  CRITICAL_ACCESS
  CANCER_CENTER
  PSYCHIATRIC_CENTER
  PSYCHIATRIC_INSTITUTE
  BEHAVIORAL_HEALTH_CENTER
  REHABILITATION_CENTER
  SPECIALTY
  PARTNER
  VENDOR
  OTHER
}

enum MemberOwnershipType {
  NONPROFIT
  FOR_PROFIT
  GOVERNMENT
  OTHER
}

/// Hospital / health system account — supports parent-child org hierarchy.
model MemberOrganization {
  id                 String                  @id @default(cuid())
  orgId              String
  parentId           String?
  name               String
  type               MemberOrganizationType  @default(HOSPITAL)
  region             String?
  bedCount           Int?
  ownership          MemberOwnershipType?
  membershipLevel    String?
  participationLevel String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  organization Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent       MemberOrganization?   @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     MemberOrganization[]  @relation("OrgHierarchy")
  members               Member[]
  emergencyContacts     EmergencyContact[]
  advocacyResponses     AdvocacyCampaignResponse[]

  @@index([orgId, parentId])
  @@index([orgId, type])
}

enum CommitteeKind {
  STANDING
  ADVISORY
  TASK_FORCE
  COUNCIL
}

enum CommitteeOfficerRole {
  CHAIR
  VICE_CHAIR
  SECRETARY
  TREASURER
  MEMBER_AT_LARGE
  MEMBER
}

enum CommitteeMeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Committee {
  id           String        @id @default(cuid())
  orgId        String
  name         String
  kind         CommitteeKind @default(STANDING)
  /// Association department slug — lib/association/departments.ts
  departmentId String        @default("member_services")
  description  String        @default("")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  organization Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberships  CommitteeMembership[]
  meetings     CommitteeMeeting[]

  @@index([orgId, departmentId])
}

model CommitteeMembership {
  id          String               @id @default(cuid())
  orgId       String
  committeeId String
  memberId    String
  title       String               @default("Member")
  officerRole CommitteeOfficerRole @default(MEMBER)
  termStart   DateTime?
  termEnd     DateTime?
  isCurrent   Boolean              @default(true)
  createdAt   DateTime             @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  committee    Committee    @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([committeeId, memberId])
  @@index([orgId, memberId])
  @@index([committeeId, officerRole])
}

model CommitteeMeeting {
  id          String                 @id @default(cuid())
  orgId       String
  committeeId String
  title       String                 @default("")
  startsAt    DateTime
  endsAt      DateTime?
  location    String                 @default("")
  virtualUrl  String                 @default("")
  agenda      String                 @default("")
  status      CommitteeMeetingStatus @default(SCHEDULED)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  committee    Committee    @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  @@index([orgId, committeeId])
  @@index([committeeId, startsAt])
  @@index([committeeId, status])
}

enum AdvocacyJurisdiction {
  STATE
  FEDERAL
  BOTH
}

enum AdvocacyIssueStatus {
  TRACKING
  ACTIVE
  WON
  LOST
  CLOSED
}

/// Healthcare advocacy topic area — drives issue templates and member hub (alpha).
enum AdvocacyIssueArea {
  ACCESS_TO_CARE
  MATERNAL_HEALTH
  WORKPLACE_VIOLENCE
  BEHAVIORAL_HEALTH
  SUBSTANCE_USE
  SDOH_FOOD_ACCESS
  PHYSICIAN_ACCESS
  NURSING_WORKFORCE
  GENERAL
}

model AdvocacyIssue {
  id            String               @id @default(cuid())
  orgId         String
  title         String
  summary       String               @default("")
  jurisdiction  AdvocacyJurisdiction @default(STATE)
  status        AdvocacyIssueStatus  @default(TRACKING)
  billNumber    String?
  departmentId  String               @default("policy")
  issueArea     AdvocacyIssueArea    @default(GENERAL)
  /// Public member-facing slug — unique per org when set.
  publicSlug    String?
  /// SME validation + KPI hints — e.g. { validationStatus: "illustrative_only" }
  contentMeta   Json?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaigns    AdvocacyCampaign[]

  @@unique([orgId, publicSlug])
  @@index([orgId, status])
  @@index([orgId, issueArea])
}

model AdvocacyCampaign {
  id            String   @id @default(cuid())
  orgId         String
  issueId       String?
  name          String
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean  @default(true)
  /** Engage audience created when take-action launches. */
  audienceId    String?
  /** Hospital participation target (typically member org count). */
  targetCount   Int      @default(0)
  /** Recorded responses — manual or future form capture. */
  responseCount Int      @default(0)
  createdAt     DateTime @default(now())

  organization Organization                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  issue        AdvocacyIssue?              @relation(fields: [issueId], references: [id], onDelete: SetNull)
  audience     EmailAudience?              @relation(fields: [audienceId], references: [id], onDelete: SetNull)
  responses    AdvocacyCampaignResponse[]

  @@index([orgId, isActive])
  @@index([orgId, audienceId])
}

enum AdvocacyResponsePosition {
  SUPPORT
  OPPOSE
  NEUTRAL
}

model AdvocacyCampaignResponse {
  id                   String                    @id @default(cuid())
  orgId                String
  campaignId           String
  memberOrganizationId String?
  hospitalName         String
  responderName        String
  responderEmail       String
  responderTitle       String?
  position             AdvocacyResponsePosition  @default(SUPPORT)
  createdAt            DateTime                  @default(now())

  organization       Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaign           AdvocacyCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  memberOrganization MemberOrganization? @relation(fields: [memberOrganizationId], references: [id], onDelete: SetNull)

  @@unique([campaignId, responderEmail])
  @@index([orgId, campaignId])
  @@index([campaignId, memberOrganizationId])
}

enum EmergencyContactSpecialty {
  GENERAL
  CLINICAL
  CYBER
  OPERATIONS
  EXECUTIVE
}

model EmergencyContact {
  id                   String                   @id @default(cuid())
  orgId                String
  memberOrganizationId String?
  memberId             String?
  roleTitle            String
  phone                String
  email                String?
  isPrimary            Boolean                  @default(false)
  region               String?
  specialty            EmergencyContactSpecialty @default(GENERAL)
  createdAt            DateTime                 @default(now())

  organization         Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberOrganization   MemberOrganization?   @relation(fields: [memberOrganizationId], references: [id], onDelete: SetNull)
  member               Member?               @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([orgId, region])
}

model EmergencyReadinessReport {
  id                   String   @id @default(cuid())
  orgId                String
  memberOrganizationId String?
  reportDate           DateTime @default(now())
  readinessScore       Int      @default(0)
  notes                String   @default("")
  submittedBy          String   @default("")
  createdAt            DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, reportDate])
}

enum IntegrationVendor {
  MICROSOFT_365
  MICROSOFT_TEAMS
  MICROSOFT_ENTRA
  EASYDNN
  POWER_BI
  SALESFORCE
  HUBSPOT
  NETSUITE
  QUICKBOOKS
  STRIPE
  ZOOM
  LMS
  LEGISLATIVE_TRACKER
  RESEND
  CLERK
  OTHER
}

enum IntegrationConnectionStatus {
  DISABLED
  PENDING
  CONFIGURED
  ERROR
}

/// Integration registry row — secrets live in Key Vault / env, not in config JSON.
model IntegrationConnection {
  id         String                      @id @default(cuid())
  orgId      String
  vendor     IntegrationVendor
  status     IntegrationConnectionStatus @default(PENDING)
  config     Json
  lastSyncAt DateTime?
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, vendor])
  @@index([orgId, status])
}
