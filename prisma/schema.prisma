// ─────────────────────────────────────────────────────────────────────────────
// PulsePoint Engage (alpha) — segments, templates, campaigns
// ─────────────────────────────────────────────────────────────────────────────

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

model EmailTemplate {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  subject   String
  bodyText  String
  bodyHtml  String   @default("")
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaigns    EmailCampaign[]

  @@unique([orgId, name])
  @@index([orgId])
}

model EmailAudience {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String   @default("")
  /** JSON filter (tags, status). Evaluated at send time. */
  filter      Json
  createdAt   DateTime @default(now())

  organization      Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaigns         EmailCampaign[]
  advocacyCampaigns AdvocacyCampaign[]

  @@index([orgId])
}

model EmailCampaign {
  id          String              @id @default(cuid())
  orgId       String
  templateId  String
  audienceId  String
  status      EmailCampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template     EmailTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  audience     EmailAudience  @relation(fields: [audienceId], references: [id], onDelete: Restrict)
  sends        EmailSendLog[]

  @@index([orgId, status])
}

model EmailSendLog {
  id           String   @id @default(cuid())
  orgId        String
  campaignId   String?
  recipient    String
  subject      String
  /** Adapter id from lib/adapters/email/*. */
  adapterId    String
  /** sent | queued | skipped (matches EmailSendResult.status). */
  result       String
  /** Provider message id when known. */
  providerId   String?
  createdAt    DateTime @default(now())

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaign     EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, campaignId])
}

enum EmailSequenceStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum EmailSequenceEnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model EmailSequence {
  id           String              @id @default(cuid())
  orgId        String
  name         String
  description  String              @default("")
  status       EmailSequenceStatus @default(DRAFT)
  fromTemplate String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  organization Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  steps        EmailSequenceStep[]
  enrollments  EmailSequenceEnrollment[]

  @@unique([orgId, name])
  @@index([orgId, status])
}

model EmailSequenceStep {
  id         String   @id @default(cuid())
  orgId      String
  sequenceId String
  stepOrder  Int
  delayDays  Int      @default(0)
  subject    String
  bodyText   String
  bodyHtml   String   @default("")

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sequence     EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, stepOrder])
  @@index([orgId])
}

model EmailSequenceEnrollment {
  id          String                        @id @default(cuid())
  orgId       String
  sequenceId  String
  memberId    String
  currentStep Int                           @default(0)
  status      EmailSequenceEnrollmentStatus @default(ACTIVE)
  nextSendAt  DateTime?
  lastSentAt  DateTime?
  enrolledAt  DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sequence     EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([orgId, sequenceId, status])
  @@index([orgId, memberId])
  @@index([nextSendAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// PulsePoint Insights (alpha) — KPI snapshots
// ─────────────────────────────────────────────────────────────────────────────

model InsightsSnapshot {
  id        String   @id @default(cuid())
  orgId     String
