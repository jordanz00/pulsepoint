# PulsePoint — copy to .env.local (never commit secrets)

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Integration profile: demo (default) | pilot-entra (Entra SSO staging) | hap-azure
# When pilot-entra or hap-azure: unset DEMO_MODE (mutually exclusive — see docs/IT-HANDOFF.md)
INTEGRATION_PROFILE=demo

# Microsoft Entra (pilot-entra / hap-azure) — see docs/ENTRA-PILOT-SETUP.md
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/entra/callback
# ENTRA_SESSION_SECRET=replace-with-32-plus-character-random-secret
# ENTRA_DEFAULT_ORG_SLUG=demo-healthcare
# ENTRA_OWNER_GROUP_ID=
# ENTRA_ADMIN_GROUP_ID=

# Microsoft Graph (M365 inbox sync) — see lib/microsoft-graph.ts
# MICROSOFT_GRAPH_CLIENT_ID=          # same or separate app registration
# MICROSOFT_GRAPH_CLIENT_SECRET=
# MICROSOFT_GRAPH_REDIRECT_URI=http://localhost:3000/api/integrations/microsoft/callback
# NEXT_PUBLIC_MARKETING_SITE_URL=https://example.com

# Sales CTAs (marketing)
NEXT_PUBLIC_SALES_CALENDAR_URL=mailto:hello@pulsepointams.com?subject=PulsePoint%20demo

# Platform cron — off by default until Stripe pilot drill passes (docs/STRIPE-PILOT-DRILL.md)
# PULSE_CRON_RENEWALS=true
# PULSE_CRON_SUBSCRIPTIONS=true

# Demo mode — standalone prototype (no Clerk; see docs/DEMO-MODE.md)
# Local: DEMO_MODE=true works when NODE_ENV is not production.
# Vercel Preview only: also set HOSTED_DEMO=true (see docs/DEPLOY-HOSTED-DEMO.md).
# Vercel Production: leave DEMO_MODE and HOSTED_DEMO unset.
DEMO_MODE=true
# HOSTED_DEMO=true
DEMO_SESSION_SECRET=replace-with-32-plus-character-random-secret

# Database — local prototype uses SQLite (no Docker)
DATABASE_URL=file:./prisma/demo.db
# Production (Neon Postgres): use POOLED URL for app runtime (hostname includes -pooler)
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb
# Then in prisma/schema.prisma: provider = "postgresql", url = env("DATABASE_URL"), directUrl = env("DIRECT_URL")
# Optional GIN search index (Postgres only): prisma/migrations/manual_search_index/migration.sql

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Stripe — https://dashboard.stripe.com (test mode). Omit keys to use manual adapter in demo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_PRICE_ID=
PAYMENT_ADAPTER=manual

# Resend — https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=PulsePoint <onboarding@resend.dev>

# Sentry — optional
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Healthcare ad-ops API (integrated packages/api — requires docker compose ams_db + redis)
AD_OPS_ENABLED=true
NEXT_PUBLIC_AD_OPS_API_URL=http://localhost:4000
