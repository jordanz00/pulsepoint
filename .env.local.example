# PulsePoint — copy to .env.local (never commit secrets)

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sales CTAs (marketing)
NEXT_PUBLIC_SALES_CALENDAR_URL=mailto:hello@pulsepointams.com?subject=PulsePoint%20demo

# Demo mode (prototype-only auth bypass — see docs/DEMO-MODE.md)
# Refuses to activate when NODE_ENV=production.
# DEMO_SESSION_SECRET must be 32+ random chars (e.g. `openssl rand -hex 32`).
DEMO_MODE=false
DEMO_SESSION_SECRET=

# Database (local Docker: docker compose up -d)
DATABASE_URL=postgresql://pulsepoint:pulsepoint@localhost:5433/pulsepoint?schema=public

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Stripe — https://dashboard.stripe.com (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_PRICE_ID=

# Resend — https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=PulsePoint <onboarding@resend.dev>

# Sentry — optional
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
