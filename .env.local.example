# PulseCore — copy to .env.local (never commit secrets)

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (local Docker: docker compose up -d)
DATABASE_URL=postgresql://pulscore:pulscore@localhost:5433/pulscore?schema=public

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Stripe — https://dashboard.stripe.com (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_PRICE_ID=

# Resend — https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=PulseCore <onboarding@resend.dev>

# Sentry — optional
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
