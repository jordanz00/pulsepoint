# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local SQLite demo database
/prisma/demo.db
/prisma/demo.db-journal

# Quake OS knowledge stores (local persistent memory)
/knowledge/*.db
/knowledge/*.db-journal
/knowledge/*.db-wal
/knowledge/*.db-shm
quake-os/memory/*.corrupt*.bak
quake-os/memory/index.json.corrupt-*.bak
quake-os/agi/mcp/servers.local.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# continuity backups (local / CI artifacts)
/backups/

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
!.env.standby.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# clerk configuration (can include secrets)
/.clerk/

# CI / local prisma sqlite
prisma/ci.db
prisma/ci.db-journal
prisma/*.db-journal
