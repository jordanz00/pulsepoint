# Copy to .env.production on standby host (never commit secrets)

NEXT_PUBLIC_APP_URL=https://standby.your-domain.example
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require

# Production pilot (Clerk) — OR demo for emergency only on private standby URL
# DEMO_MODE=true
# HOSTED_DEMO=true
# DEMO_SESSION_SECRET=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

INTEGRATION_PROFILE=demo
